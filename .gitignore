# Mac
.DS_Store

# Spring
/logs/

# OIL
OILLogs/

# Code coverage
.coverage
.coverage_db_*
coverage*.xml
junit_results.xml
htmlcov*/

# Python
*.pyc
__pycache__/
/venv/
/.venv/

# Secrets — the `local` secrets provider reads KEY=VALUE from a dotenv file
.env
.env.*
!.env.example

# Poetry
# lock file should not be committed because dependency lock is managed by uv
poetry.lock

# Tests
.tox/

# IDEs
# Eclipse
.classpath
.project
.settings/
.factorypath
# Intellij
.idea/
# ms vscode
.vscode/

# Builds
dist/
*.egg-info/

# Claude
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Cursor (track rules and skills)
.cursor/*
!.cursor/rules/
!.cursor/skills/
# Personal/machine-specific cursor rules (e.g. account IDs, instance IDs,
# eiamCli recipes that aren't safe to commit). Use the *.local.mdc suffix.
.cursor/rules/*.local.mdc

# Project-specific
data/
plans/
tmp/
.scratch/
/configs/
# rl-train tokenize-pack's local --output dir before --upload-to pushes it
# to S3 (docs/launching-sft-verl.md's own example uses --output
# ./packed_local; per-model runs use ./packed_local_<name>, e.g.
# packed_local_muse) — packed Parquet + a metadata sidecar, regenerable
# from the S3 source data, not something to commit.
/packed_local*/
job_tracking/*
!job_tracking/README.md
!job_tracking/.gitkeep
# examples/configs/ doubles as a scratch area for real, working configs that
# carry bucket names and account IDs, so the directory is ignored by default and
# committed templates are allowlisted one by one. Anything not listed here is
# invisible to git -- and therefore to scripts/make_oss_tree.sh, which copies
# only tracked files. Add new templates to this list or they will not ship.
examples/configs/*
!examples/configs/README.md
!examples/configs/oss_quickstart.yaml
!examples/configs/sagemaker_training_job_example.yaml
!examples/configs/sagemaker_serverless_example.yaml
!examples/configs/perf_test_example.yaml
!examples/configs/optimizer_example.yaml
!examples/configs/evaluate_example.yaml
!examples/configs/local_example.yaml
!examples/configs/hyperpod_eks_example.yaml
!examples/configs/sagemaker_sft_verl_example.yaml
!examples/configs/muse_glimmer_sft_verl.yaml
docs/implementation-plan.md

# Local-GPU requirements (generated by rl-train setup-local-gpu)
local-requirements.txt

# A pip freeze of the local environment, dropped in the working directory by the
# Aleta SDK (`set_requirements_file`) whenever the evaluate `aleta` reporter
# runs. Rooted so it cannot shadow the real, tracked requirements files under
# foresightrlcore/config/requirements/ and runtime/scripts/.
/requirements.txt

# Ruff / mypy caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Secrets, keys, and model weights
.env
*.pem
*.key
*.pt
*.bin
*.safetensors
*.ckpt
